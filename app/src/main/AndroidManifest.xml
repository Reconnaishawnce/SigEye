<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ scanning. We deliberately do NOT set neverForLocation: we want
         unfiltered scans and we already hold FINE_LOCATION for API 26-30 anyway. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Blink is the only experiment that transmits. Asked for here because the manifest
         has to declare it, and requested at runtime only on that screen. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Android 11 and below -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Required for BLE scan results on every API level we support -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Cell Handovers. Location is the blocking one; some OEMs withhold the cell
         identity without phone state as well. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Wi-Fi survey. Both are normal permissions; the results themselves are gated on
         the location permission we already hold. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Doppler Walk. The step counter returns nothing without this on Android 10+,
         silently, which is why the screen checks and says so. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Alerts. This is a normal permission, granted at install, and without it
         Vibrator.vibrate() throws a SecurityException that costs nothing to ignore and
         silently does nothing - which is exactly what it did until someone noticed. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Time-of-flight ranging. Most phones have no such radio, so the app must install
         and run without it and True Ranging says so on its own screen. -->
    <uses-feature android:name="android.hardware.wifi.rtt" android:required="false" />

    <application
        android:name=".SigEyeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SigEye"
        tools:targetApi="34">

        <!-- Handling these ourselves rather than letting Android recreate the activity.
             Compose recomposes against the new configuration quite happily, whereas a
             recreation throws away every remembered value - which meant that turning the
             phone sideways during a sweep destroyed the sweep. Three experiments ask the
             user to move the phone about while it records, so this was not theoretical. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SigEye">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.ScanService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
