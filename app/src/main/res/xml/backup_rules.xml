<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's automatic backup takes, spelled out.

  Backup is deliberately left on, and the app warns about it on first run rather than
  deciding for the user. This file exists so that what goes is a written-down decision
  instead of a default nobody looked at: everything here ends up in the user's Google
  account, including the names they have given to other people's devices and the log of
  which addresses were linked to which.

  Naming an include is the whole statement. Everything not listed is excluded by that
  alone, which is why there are no exclude lines - adding them is an error, because a path
  cannot be excluded from a set it was never in. Recorded sessions and exported CSVs live
  in getExternalFilesDir and are therefore out: those are the bulk observations, and a
  backup is not where they belong.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
</full-backup-content>
